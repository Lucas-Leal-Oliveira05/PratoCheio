# Copie para .env e troque usuário e senha pelos do seu PostgreSQL.
# Banco do produto (npm start, npm run db:migrar):
DATABASE_URL=postgres://pratocheio:SUA_SENHA@localhost:5432/pratocheio
# Banco só de testes (npm test apaga as doações dele antes de cada teste):
DATABASE_URL_TEST=postgres://pratocheio:SUA_SENHA@localhost:5432/pratocheio_test
